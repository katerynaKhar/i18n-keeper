{
  "name": "i18n-keeper",
  "version": "0.4.0",
  "description": "Deterministic i18n linter for JSON and Laravel PHP locale files, as a CLI and an MCP server.",
  "type": "module",
  "bin": {
    "i18n-keeper": "dist/cli.js",
    "i18n-keeper-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "demo": "node dist/cli.js check fixtures/demo",
    "demo:laravel": "node dist/cli.js check fixtures/laravel",
    "demo:plurals": "node dist/cli.js check fixtures/plurals",
    "demo:glossary": "node dist/cli.js check fixtures/glossary",
    "walkthrough": "node scripts/stale-walkthrough.mjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "test:php": "node scripts/php-oracle.mjs",
    "test:laravel": "node scripts/php-checks.mjs",
    "test:plurals": "node scripts/plural-checks.mjs && node scripts/plural-integration.mjs",
    "test:glossary": "node scripts/glossary-checks.mjs"
  },
  "keywords": [
    "i18n",
    "l10n",
    "lint",
    "locales",
    "translation",
    "laravel",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
