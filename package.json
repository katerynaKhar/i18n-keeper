{
  "name": "@katerynakhar/i18n-keeper",
  "version": "0.17.1",
  "description": "Deterministic i18n linter for JSON, Laravel PHP, gettext and YAML locale files, as a CLI and an MCP server.",
  "type": "module",
  "bin": {
    "i18n-keeper": "dist/cli.js",
    "i18n-keeper-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katerynaKhar/i18n-keeper.git"
  },
  "homepage": "https://github.com/katerynaKhar/i18n-keeper#readme",
  "bugs": {
    "url": "https://github.com/katerynaKhar/i18n-keeper/issues"
  },
  "author": "KATERYNA",
  "license": "MIT",
  "keywords": [
    "i18n",
    "l10n",
    "lint",
    "locales",
    "translation",
    "gettext",
    "laravel",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "demo": "node dist/cli.js check fixtures/demo",
    "demo:laravel": "node dist/cli.js check fixtures/laravel",
    "demo:plurals": "node dist/cli.js check fixtures/plurals",
    "demo:glossary": "node dist/cli.js check fixtures/glossary",
    "demo:lengths": "node dist/cli.js check fixtures/lengths --rule length_over_max --rule length_overflow",
    "demo:gettext": "node dist/cli.js check fixtures/gettext",
    "demo:rails": "node dist/cli.js check fixtures/rails",
    "walkthrough": "node scripts/stale-walkthrough.mjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "test:php": "node scripts/php-oracle.mjs",
    "test:laravel": "node scripts/php-checks.mjs",
    "test:plurals": "node scripts/plural-checks.mjs && node scripts/plural-integration.mjs",
    "test:glossary": "node scripts/glossary-checks.mjs",
    "test:lengths": "node scripts/length-checks.mjs",
    "test:formats": "node scripts/format-checks.mjs",
    "test:placeholders": "node scripts/placeholder-checks.mjs",
    "test:translate": "node scripts/translate-checks.mjs && node scripts/repair-checks.mjs",
    "test:apply": "node scripts/apply-checks.mjs",
    "test:writers": "node scripts/writer-checks.mjs",
    "test:review": "node scripts/review-checks.mjs",
    "test:fixtures": "node scripts/fixture-checks.mjs",
    "test": "npm run build && npm run test:version && npm run test:fixtures && npm run test:detection && npm run test:php && npm run test:laravel && npm run test:plurals && npm run test:glossary && npm run test:lengths && npm run test:formats && npm run test:placeholders && npm run test:translate && npm run test:apply && npm run test:writers && npm run test:review && npm run smoke && npm run walkthrough",
    "test:version": "node scripts/version-checks.mjs",
    "test:detection": "node scripts/detection-checks.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
